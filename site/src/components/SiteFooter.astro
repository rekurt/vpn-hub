---
import type { LandingCopy } from '../data/landing';

type Props = {
  copy: LandingCopy;
};

const { copy } = Astro.props;
const localeRoot = copy.locale === 'en' ? '/vpn-hub' : `/vpn-hub/${copy.locale}`;
---

<footer id="landing-footer" class="landing-footer">
  <p>
    <span>{copy.nav.home}</span>
    ·
    <a href="https://github.com/rekurt/vpn-hub" target="_blank" rel="noreferrer">GitHub</a>
    ·
    <a href={`${localeRoot}/docs/operations/`}>{copy.nav.docs}</a>
  </p>
  <p>
    © 2026 VPN Hub.
  </p>
</footer>

---
type CookbookLink = {
  title: string;
  description: string;
  url: string;
};

type Props = {
  id: string;
  heading: string;
  intro: string;
  links: CookbookLink[];
};

const { id, heading, intro, links } = Astro.props as Props;
---

<section class="landing-section" id={id} aria-labelledby={`${id}-title`}>
  <p class="section-eyebrow">06 / repeatable operations</p>
  <h2 id={`${id}-title`}>{heading}</h2>
  <p>{intro}</p>
  <div class="cookbook-grid">
    {links.map((link) => (
      <a class="cookbook-grid__card" href={link.url}>
        <h3>{link.title}</h3>
        <p>{link.description}</p>
      </a>
    ))}
  </div>
</section>

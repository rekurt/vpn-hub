---
type Protocol = {
  name: string;
  role: string;
  notes: string;
};

type Props = {
  id: string;
  heading: string;
  protocols: Protocol[];
};

const { id, heading, protocols } = Astro.props as Props;
---

<section class="landing-section" id={id} aria-labelledby={`${id}-title`}>
  <p class="section-eyebrow">02 / transport, by intent</p>
  <h2 id={`${id}-title`}>{heading}</h2>
  <div class="protocol-rail">
    {protocols.map((protocol) => (
      <article class="protocol-rail__card">
        <h3>{protocol.name}</h3>
        <p class="protocol-rail__role">{protocol.role}</p>
        <p>{protocol.notes}</p>
      </article>
    ))}
  </div>
</section>

---
type UseCase = {
  title: string;
  summary: string;
  commandHint: string;
  category: string;
};

type Props = {
  id: string;
  heading: string;
  items: UseCase[];
};

const { id, heading, items } = Astro.props as Props;
---

<section class="landing-section" id={id} aria-labelledby={`${id}-title`}>
  <p class="section-eyebrow">04 / covered in the real world</p>
  <h2 id={`${id}-title`}>{heading}</h2>
  <div class="usecase-grid">
    {items.map((item) => (
      <article class="usecase-grid__card">
        <h3>{item.title}</h3>
        <p class="usecase-grid__category">{item.category}</p>
        <p>{item.summary}</p>
        <p><code>{item.commandHint}</code></p>
      </article>
    ))}
  </div>
</section>

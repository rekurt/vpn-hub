---
interface Props {
  command: string;
  expected: string;
}

const { command, expected } = Astro.props;
---

<aside class="verify-block" aria-label="Verification">
  <strong>Verify</strong>
  <pre><code>{command}</code></pre>
  <p><strong>Expected:</strong> {expected}</p>
</aside>

<style>
  .verify-block {
    background: color-mix(in srgb, var(--vpn-cyan) 9%, transparent);
    border-inline-start: 0.3rem solid var(--vpn-cyan);
    margin-block: 1.5rem;
    padding: 1rem 1.25rem;
  }

  .verify-block pre {
    overflow-x: auto;
  }

  .verify-block p:last-child {
    margin-block-end: 0;
  }
</style>

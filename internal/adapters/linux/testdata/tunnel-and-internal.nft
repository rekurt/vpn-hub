# Managed by vpn-hub. Manual edits are reverted on the next reconcile.

# Creating the table before deleting it makes the definition below an atomic
# replacement of this table alone, leaving any other ruleset on the host intact.
table inet vpn_hub
delete table inet vpn_hub

table inet vpn_hub {
	comment "vpn-hub:bebff6ef9348359a"

	set client_direct {
		type ipv4_addr
		elements = { 10.80.0.2, 10.80.0.3 }
	}

	set client_corp_wg {
		type ipv4_addr
		elements = { 10.80.0.4 }
	}

	set internal_v4 {
		type ipv4_addr
		flags interval
		elements = { 10.20.0.0/16 }
	}

	chain prerouting {
		type filter hook prerouting priority mangle; policy accept;
		iifname != "awg0" accept
		ip daddr @internal_v4 accept
		ip saddr @client_direct meta mark set 0x00000100
		ip saddr @client_corp_wg meta mark set 0x00000101
		ct mark set meta mark
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
		iifname "awg0" oifname "awg0" drop
		iifname "awg0" ip daddr @internal_v4 accept
		iifname "awg0" ip saddr @client_direct oifname "eth0" accept
		iifname "awg0" ip saddr @client_corp_wg oifname "vh-corp-wg" accept
	}

	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		iif lo accept
		ip protocol icmp accept
		tcp dport 22 accept
		udp dport 51820 accept
		iifname "awg0" ip daddr 10.80.0.1 udp dport 53 accept
		iifname "awg0" ip daddr 10.80.0.1 tcp dport 53 accept
	}

	chain output {
		type filter hook output priority filter; policy accept;
		meta nfproto ipv6 drop
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		ip saddr 10.80.0.0/24 oifname "eth0" masquerade
	}
}

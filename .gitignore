/plans
/service
/bin
/.worktrees/
# Everything under configs/ is live hub material (keys, device configs, upstream
# links); only the template is committed. A blanket ignore keeps a stray `git add`
# from ever committing a real credential.
/configs/*
!/configs/example.yaml

# OpenTofu state holds the API token and resource IDs. The lock file is committed.
deploy/terraform/.terraform/
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.*
deploy/terraform/*.tfvars

# Guard against tofu being run from the wrong directory.
/terraform.tfstate*
/state/
/device-profiles/
/backups/
desired-state.json
*.tfstate*

# Generated Astro site artifacts are reproducible from site/package-lock.json.
site/node_modules/
site/dist/
site/.astro/
site/.pagefind/

# Local Superdesign canvases and analysis state.
.superdesign/

[Unit]
Description=Private Multi-VPN Hub reconciler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/vpn-hub-agent serve --state-dir /var/lib/vpn-hub --interval 1m
Restart=on-failure
RestartSec=5s

# systemd creates and owns these, so the unit no longer fails with 226/NAMESPACE on a
# clean host. They map to /run/vpn-hub, /var/lib/vpn-hub and /etc/vpn-hub.
RuntimeDirectory=vpn-hub
StateDirectory=vpn-hub
ConfigurationDirectory=vpn-hub
# All three hold secrets -- the runtime key, the persisted device-profile keys and
# state, and the config/token -- so close them to their owner. Declaring the mode
# also matches what is already on disk: without it systemd assumes the 0755 default
# and logs "mode is different" on every start against the 0700 directories.
RuntimeDirectoryMode=0700
StateDirectoryMode=0700
ConfigurationDirectoryMode=0700
# Preserve /run/vpn-hub across a restart of this service. It is shared with
# vpn-hub-bot, and the reconciler keeps live files here (awg0.key, the egress
# management sockets and rendered upstream configs). Without this, restarting one of
# the two services while the other holds the directory has been observed to leave the
# restarted service without the read-write bind mount of /run/vpn-hub -- writes then
# fail EROFS and the egress sockets vanish. Keeping the directory removes that churn.
RuntimeDirectoryPreserve=yes

UMask=0077
ProtectSystem=strict
# RuntimeDirectory is normally writable under ProtectSystem=strict. Declare it
# explicitly as well: the reconciler writes one-time key and provider files here,
# and older systemd sandbox combinations otherwise expose it read-only.
ReadWritePaths=/run/vpn-hub
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=~user pid ipc uts cgroup
SystemCallArchitectures=native

# Creating a network namespace is a bind mount under /run/netns, and the directives
# above give this service a private mount namespace where such a mount would be
# confined and unusable -- even to the agent itself. The agent therefore delegates
# `ip netns add|del` to a transient unit, which performs the mount in the host's
# namespace; systemd mounts with MS_SLAVE, so it propagates back in here while this
# service's own mounts stay contained. That is what lets the sandbox stay on.
#
# setns is still needed to enter those namespaces, and @mount for the tooling that
# reads the mount table.
SystemCallFilter=@system-service @mount
SystemCallFilter=setns unshare

# The reconciler drives netlink, nftables and network namespaces; everything else is dropped.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN

# ProtectKernelTunables is deliberately NOT set: the agent writes
# /proc/sys/net/ipv4/ip_forward inside each tunnel namespace.

[Install]
WantedBy=multi-user.target

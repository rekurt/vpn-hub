[Unit]
Description=Private Multi-VPN Hub reconciler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/vpn-hub-agent serve --state-dir /var/lib/vpn-hub --interval 1m
Restart=on-failure
RestartSec=5s

# systemd creates and owns these, so the unit no longer fails with 226/NAMESPACE on a
# clean host. They map to /run/vpn-hub, /var/lib/vpn-hub and /etc/vpn-hub and are
# implicitly writable even under ProtectSystem=strict.
RuntimeDirectory=vpn-hub
StateDirectory=vpn-hub
ConfigurationDirectory=vpn-hub

UMask=0077

# Mount-based sandboxing is deliberately absent, and this is the one hardening
# trade-off the agent makes.
#
# `ip netns add` bind-mounts a namespace handle into /run/netns. Anything that gives
# the service a private mount namespace -- ProtectSystem, ProtectHome, PrivateTmp --
# confines that mount to the service, where it is unusable even by the agent's own
# later invocations: the namespace appears to exist and every operation on it fails
# with "Invalid argument". MountFlags=shared does not rescue it, and neither does
# CAP_SYS_ADMIN; managing network namespaces and having a private mount namespace are
# simply incompatible.
#
# Everything that does not depend on mount isolation is kept below.
ProtectHome=false
PrivateTmp=false
NoNewPrivileges=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=~user pid ipc uts cgroup
SystemCallArchitectures=native
# @system-service alone kills `ip netns add` with SIGSYS: creating a network
# namespace needs unshare and setns, and `ip` bind-mounts the handle into /run/netns,
# which needs @mount. Found only after a reboot -- running the agent by hand from a
# shell carries no seccomp filter, so the failure is invisible outside systemd.
SystemCallFilter=@system-service @mount
SystemCallFilter=setns unshare

# The reconciler drives netlink, nftables and network namespaces; everything else is dropped.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN

# ProtectKernelTunables is deliberately NOT set: the agent writes
# /proc/sys/net/ipv4/ip_forward inside each tunnel namespace.

[Install]
WantedBy=multi-user.target

[Unit]
Description=Refresh vpn-hub provider subscriptions
After=network-online.target vpn-hub-agent.service
Wants=network-online.target

[Service]
# This unit parses what a provider sends over the network and brings a candidate up
# in a namespace of its own, so it is the one most worth confining. It needs the same
# network capabilities as the agent and nothing else.
NoNewPrivileges=true
ProtectHome=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN CAP_DAC_OVERRIDE

Type=oneshot
User=root
# One tunnel per invocation; %i is the tunnel ID. A candidate is proven in an
# isolated namespace before anything depends on it, so a failure here leaves the
# active upstream untouched.
ExecStart=/usr/local/bin/hubctl subscription refresh %i --config /etc/vpn-hub/hub.yaml
# The refresh builds a namespace of its own, so it needs the same latitude the agent
# has and cannot run under mount isolation.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN

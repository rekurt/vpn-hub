[Unit]
Description=vpn-hub admin Telegram bot
After=network-online.target vpn-hub-agent.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/vpn-hub-bot serve
Restart=always
RestartSec=5s

RuntimeDirectory=vpn-hub
StateDirectory=vpn-hub
ConfigurationDirectory=vpn-hub
# The token lives in /etc/vpn-hub and the offset/settings in /var/lib/vpn-hub;
# close all three directories to their owner even though the files inside are 0600.
# Declaring every mode also keeps systemd from logging "mode is different" when it
# finds the on-disk 0700 under its assumed 0755 default.
RuntimeDirectoryMode=0700
ConfigurationDirectoryMode=0700
StateDirectoryMode=0700
# Shared with vpn-hub-agent: keep /run/vpn-hub across a restart of this service so a
# single-service restart cannot tear the shared runtime directory (and the egress
# sockets and keys the agent keeps there) out from under the other service.
RuntimeDirectoryPreserve=yes

# The bot is the operator's seat, not the reconciler: it edits /etc/vpn-hub, forks
# systemctl/journalctl/qrencode and builds the canary namespace for subscription
# refreshes. None of that needs a writable system: the canary namespace is built
# through the same systemd-run delegation the agent uses under this very setting,
# and forking systemctl or qrencode writes nothing outside the two directories
# named below. ConfigurationDirectory gets no implicit write exemption under
# strict, so /etc/vpn-hub is listed explicitly -- the config editor and the
# upstream link files live there.
ProtectSystem=strict
ReadWritePaths=/etc/vpn-hub /run/vpn-hub
UMask=0077
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectClock=true
ProtectHostname=true
SystemCallArchitectures=native
# Telegram over INET, systemd/journald over UNIX, ip/nft over NETLINK -- nothing
# else. ProcSubset/ProtectProc are deliberately NOT set: the /host screen reads
# /proc/uptime and /proc/loadavg.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Long polling only: the bot dials out to api.telegram.org and listens on nothing.
# The canary namespace needs the same network capabilities as the agent.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN

[Install]
WantedBy=multi-user.target

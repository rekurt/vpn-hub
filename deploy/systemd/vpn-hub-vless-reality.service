[Unit]
Description=vpn-hub VLESS Reality fallback
After=network-online.target vpn-hub-agent.service
Wants=network-online.target vpn-hub-agent.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/sing-box run -c /etc/vpn-hub/vless-reality/config.json
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target

# Copy to terraform.tfvars (gitignored) and adjust. SSH source ranges are required.

# Keep a second workstation's already-registered key on the host. MD5 fingerprints come
# from `doctl compute ssh-key list`.
# extra_ssh_key_fingerprints = ["65:9a:58:5e:5c:ba:0f:e2:bc:b7:8f:fe:9a:4a:b6:34"]

# Replace this documentation-only address with the operator's trusted source range
# before applying. Do not set allow_global_ssh unless using an explicit break-glass
# recovery procedure.
ssh_allowed_cidrs = ["198.51.100.10/32"]

# region = "fra1"
# size   = "s-1vcpu-1gb"
